#!/bin/bash
# CS152 Lab 2, open-ended 2 -- build the simulator with YOUR prefetcher.
#
#   ./build-prefetcher                 # uses ./prefetcher.cc
#   ./build-prefetcher pf_stream1.cc   # uses a different model
#   PF_CONFIG=<config> ./build-prefetcher ...   # a different cache geometry
#
# The first build verilates the whole SoC and takes a few minutes.  Every build
# after that recompiles your .cc and relinks -- about six seconds -- which is
# the edit-measure loop this problem is built around.
#
# Reading order: main() at the bottom says what happens; each step above it says
# why that step is needed.  Steps 2-4 exist only to work around how Verilator's
# generated makefiles handle an extra source file.
set -euo pipefail

HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$HERE/../.." && pwd)
SIMDIR="$ROOT/sims/verilator"
CONFIG=${PF_CONFIG:-CS152Lab2PrefetchConfig}
SIM="$SIMDIR/simulator-chipyard.harness-$CONFIG"
GENDIR="$SIMDIR/generated-src/chipyard.harness.TestHarness.$CONFIG"

# The model is always compiled from this ONE path, whatever you called your
# file.  See stage_model().
FIXED="$SIMDIR/cs152-prefetcher-model.cc"

# ---- step 1: the environment must already be active -------------------------
# This CHECKS rather than activates: activating here would paper over a broken
# setup and fail further in with a much less obvious error.  A bare `verilator`
# on PATH proves nothing -- there is a system one in /usr/bin -- so test tools
# only the conda environment provides.
check_env() {
  local t
  for t in firtool elf2hex; do
    command -v "$t" >/dev/null 2>&1 && continue
    echo "$t not on PATH -- the lab environment is not active." >&2
    echo "Run:  source ~/cs152-env.sh cs152-lab2-fa26" >&2
    exit 2
  done
}

# ---- step 2: copy the model to one fixed path -------------------------------
# Verilator bakes the source path it was given into the generated V*.mk at
# VERILATION time, so pointing the build at a different .cc would force a full
# re-verilation every time you switched models.  Copying to one stable path
# makes switching a relink instead.
# `cmp` first: an unchanged file must keep its timestamp, or make rebuilds on
# every invocation.
# Headers beside the model come too -- Verilator compiles with -I. in the build
# directory, so a model split across several files works: put its headers next
# to it.  A single-file model needs none of this.
stage_model() {                      # $1 = the .cc the user named
  local src=$1 dir h
  dir=$(dirname "$src")
  # Same cmp guard for the headers as for the .cc.  They ARE prerequisites --
  # the generated cs152-prefetcher-model.d lists them -- so an unconditional
  # copy refreshes their mtimes and relinks the whole simulator (~6 s) on every
  # build that should have been a no-op.
  cmp -s "$src" "$FIXED" || cp -f "$src" "$FIXED"
  for h in "$dir"/*.h "$dir"/*.inc; do
    [ -e "$h" ] || continue
    cmp -s "$h" "$SIMDIR/$(basename "$h")" || cp -f "$h" "$SIMDIR/"
  done
  return 0
}

# ---- step 3: force ONE re-verilation when the path is not yet wired in ------
# EXTRA_SIM_SOURCES is not a prerequisite of the verilation step, so changing it
# does not by itself get the new path picked up.  If the generated makefile does
# not mention our fixed path, delete it once; every build after that is fast.
force_reverilate_once() {
  ls "$GENDIR"/*/V*.mk >/dev/null 2>&1 || return 0
  grep -q "$(basename "$FIXED" .cc)" "$GENDIR"/*/V*.mk 2>/dev/null && return 0
  echo "generated makefile does not reference the model path yet -- re-verilating once"
  rm -f "$GENDIR"/*/V*.mk
}

# ---- step 4: build ----------------------------------------------------------
# $(sim) lists the C/C++ files from EXTRA_SIM_SOURCES as prerequisites (fixed in
# sims/verilator/Makefile), so editing your model makes the simulator out of
# date on its own, without this script having to delete anything.
build() {
  echo "building $CONFIG with $1"
  # -j matters: VM_PARALLEL_BUILDS=1 splits the model into ~84 translation
  # units precisely so they can compile together, but without -j no jobserver
  # reaches the generated V*.mk, and the ~99 objects then compile one at a
  # time.
  make -C "$SIMDIR" -j"$(nproc)" CONFIG="$CONFIG" EXTRA_SIM_SOURCES="$FIXED"
  echo
  echo "built: $SIM"
}

main() {
  local src
  src=$(realpath "${1:-$HERE/prefetcher.cc}" 2>/dev/null) \
    || { echo "no such file: ${1:-$HERE/prefetcher.cc}" >&2; exit 2; }
  [ -f "$src" ] || { echo "no such file: $src" >&2; exit 2; }

  check_env
  stage_model "$src"
  force_reverilate_once
  build "$src"
}

main "$@"
